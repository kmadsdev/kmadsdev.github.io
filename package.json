    "deploy": "gh-pages -d dist --cname kmads.dev --nojekyll"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@fontsource/anton": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/rubik": "^5.2.8",
    "lenis": "^1.3.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
