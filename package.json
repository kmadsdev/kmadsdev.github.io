{
  "name": "kmadsdev-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://kmads.dev",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
